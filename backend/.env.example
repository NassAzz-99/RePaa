# Server
PORT=3000
# Bind ke 0.0.0.0 agar bisa diakses emulator/perangkat fisik
HOST=0.0.0.0

# Database PostgreSQL
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/reservasi_paa?schema=public"

# JWT
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
JWT_EXPIRES_IN=7d

# Public URL untuk membentuk photo_url
# Emulator Android: http://10.0.2.2:3000
# Perangkat fisik: http://192.168.x.x:3000
PUBLIC_URL=http://10.0.2.2:3000

# Timezone bisnis
TZ=Asia/Jakarta
